# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored: never commit a real API key.

# --- LLM endpoint (any OpenAI-compatible API) -------------------------------
# Default: Groq. See the "LLM providers" section of the README for others.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=openai/gpt-oss-20b

# Local server, e.g. Ollama (no key needed, any non-empty value works):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=your-model-name

# --- Optional tuning ---------------------------------------------------------
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=4        # retries on HTTP 429 / 5xx, with exponential backoff
# LLM_RETRY_BASE_S=2
# MAX_STEPS=5              # max LLM round-trips per question

# --- Rate limit on /ask (public demos; 0 = no limit) ------------------------
# ASK_RATE_LIMIT=10        # questions per visitor per window
# ASK_GLOBAL_LIMIT=60      # questions per window, all visitors together
# ASK_RATE_WINDOW_S=3600
# TRUST_FORWARDED_FOR=false  # true behind a reverse proxy (e.g. a hosted demo)

# --- Models and uploads ------------------------------------------------------
# SAMPLES_DIR=data/samples
# MAX_UPLOAD_MB=10
# MAX_FACES=200000           # largest mesh accepted
# MAX_UPLOADS_PER_SESSION=2  # the oldest upload is replaced beyond this
# MAX_SESSIONS=20            # sessions kept in memory; the least recent is dropped

# LOG_LEVEL=INFO
